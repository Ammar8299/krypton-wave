{
  "name": "krypton-wave",
  "version": "1.0.0",
  "description": "Kπyρτόn_wave~ — Post-Quantum Cryptographic Networking Experiment (ML-KEM-768 + Falcon-512 + AES-256-GCM)",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@noble/post-quantum": "^0.7.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kryptonwave.app",
    "productName": "Kπyρτόn_wave~",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/crypto/**/*",
      "src/network/**/*",
      "src/storage/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
